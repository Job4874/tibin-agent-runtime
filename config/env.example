# Copy this file to `.env` in the repo root and fill in your own keys.
# Never commit `.env`. The runtime does not ship or host any API keys.

# --- Autonomous / API providers (bring your own keys) ---

# OpenRouter: default autonomous brain in config/model_providers.json
# and config/brain.json. Leave empty to disable autonomous API runs.
OPENROUTER_API_KEY=

# Official OpenAI / Codex API. To use it, set this key and point the
# openai_compatible provider in config/model_providers.json at
#   "api_key_env": "OPENAI_API_KEY",
#   "base_url": "https://api.openai.com/v1",
#   "model": "gpt-4.1"   # or another chat-completions model you have access to
# Codex CLI/IDE workflows can use the same key independently; this runtime
# talks to the OpenAI-compatible Chat Completions API, not a hosted service.
OPENAI_API_KEY=

# Optional: other OpenAI-compatible endpoints (Azure OpenAI, proxies, local servers)
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Dashboard / local server ---

# Optional: fixed token required by all mutating /api/* dashboard routes.
# If unset, a random token is generated per server process (the dashboard UI
# picks it up automatically; external scripts should set this explicitly and
# send it as "X-Tibin-Token: <token>" or "Authorization: Bearer <token>").
TIBIN_API_TOKEN=

# Optional: extra Host header values allowed by the dashboard
# (comma-separated). Defaults to 127.0.0.1/localhost only.
TIBIN_ALLOWED_HOSTS=

# Set to 1 to enable Flask debug mode. NEVER enable in production.
TIBIN_DEBUG=0
