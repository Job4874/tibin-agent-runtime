{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "partial",
        "blocked",
        "needs_manual_review"
      ]
    },
    "data": {
      "type": "object"
    },
    "error": {
      "type": "string"
    }
  }
}