{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "plan_id": {
      "type": "string"
    },
    "objective_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_domains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requested_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "action.schema.json"
      }
    },
    "verification": {
      "type": "string"
    },
    "rollback": {
      "type": "string"
    },
    "approval": {
      "type": "boolean"
    },
    "expected_outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "complexity": {
      "type": "object",
      "properties": {
        "problem_type": {
          "type": "string",
          "enum": [
            "coding",
            "research",
            "browser",
            "debugging",
            "planning",
            "mixed"
          ]
        },
        "estimated_depth": {
          "type": "string",
          "enum": [
            "simple",
            "medium",
            "deep",
            "unknown"
          ]
        },
        "requires_research": {
          "type": "boolean"
        },
        "requires_context_recovery": {
          "type": "boolean"
        },
        "requires_human_input": {
          "type": "boolean"
        },
        "known_unknowns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decomposition": {
          "type": "object",
          "properties": {
            "milestones": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "next_smallest_action": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "required": [
    "plan_id",
    "objective_id",
    "title",
    "actions",
    "complexity"
  ]
}